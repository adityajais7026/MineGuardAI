[TEMPLATE]
# ============================================================================
# MineGuardAI backend - environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# --- Application ---
APP_NAME=MineGuardAI API
APP_VERSION=0.1.0
DEBUG=false
API_PREFIX=/api

# --- CORS (comma-separated list of allowed frontend origins) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
# Supabase PostgreSQL connection string (Project Settings -> Database).
# Example:
# DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres
# Leave unset for local development to use a SQLite file (backend/mineguardai.dev.db).
DATABASE_URL=

# --- Supabase project (Auth adapter + Storage) ---
# Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key: backend only. NEVER expose to the frontend or commit it.
# Required for Supabase Storage uploads (camera media bucket).
SUPABASE_SERVICE_KEY=

# --- Supabase Storage (camera media; PRIVATE bucket) ---
# Create a private bucket named below (Dashboard -> Storage -> New bucket).
# When SUPABASE_URL + SUPABASE_SERVICE_KEY are set, uploads go to Supabase
# Storage under camera/{mine_id}/{images|videos|results}/...
# Without credentials the backend stores files locally (backend/snapshots/media,
# gitignored) and reports storage_provider="local" - it never fakes Supabase.
SUPABASE_MEDIA_BUCKET=mineguard-media
# "supabase" | "local"  ("local" forces dev storage even if creds exist)
STORAGE_PROVIDER=supabase

# --- Authentication ---
# "local"  -> backend issues its own JWTs (development without Supabase Auth)
# "supabase" -> verify Supabase-issued JWTs (requires SUPABASE_URL + key)
AUTH_PROVIDER=local
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Seeded admin account (created by `python -m app.utils.seed`) ---
SEED_ADMIN_EMAIL=admin@mineguard.ai
SEED_ADMIN_PASSWORD=Admin@123

# --- AI / Computer vision ---
# "simulated" -> clearly-labelled simulated camera events (fallback mode).
# "yolo"      -> REAL YOLO inference on uploaded media via /api/ai/detect/*.
AI_DETECTOR=simulated
# Generic pretrained COCO model (person/car/truck/...) OR a fine-tuned PPE
# model. PPE model used by this project: SafetyVision YOLOv8s (13 classes:
# Hardhat, NO-Hardhat, Safety Vest, NO-Safety Vest, Gloves, NO-Gloves,
# Goggles, NO-Goggles, Mask, NO-Mask, No_Harness, Person, Fall-Detected) —
# AGPL-3.0, source: https://huggingface.co/ayushgupta7777/safetyvision-yolov8
# (file v2/best.pt). Place the weights at the path below; class names are
# read from the model — nothing is renamed or inferred.
YOLO_MODEL_PATH=../ai/yolo/models/yolo11n.pt
# Download yolo11n.pt automatically when missing (explicit opt-in).
YOLO_AUTO_DOWNLOAD=false
# Default inference settings (overridable per request from the UI).
YOLO_CONFIDENCE=0.35
YOLO_IMGSZ=640
# Process every Nth video frame (1 = all frames, slower).
YOLO_FRAME_STRIDE=5
# Safety rule: persons per scene before a crowd alert fires.
YOLO_CROWD_THRESHOLD=4

# --- EXPERIMENTAL YOLO-World detector (OPT-IN; Vyra stays production) ------
# AI_DETECTOR=yolo_world switches image/video/live inference to the open-
# vocabulary YOLO-World model (six text classes: person, hard hat, gloves,
# safety glasses, safety vest, safety shoes). NOT fine-tuned on MineGuardAI
# data and NOT benchmarked production-ready - see ai/YOLO_WORLD.md. The model
# verifies its six-class inventory on load and refuses anything else.
# Default ("simulated"/"yolo") NEVER activates this backend.
#AI_DETECTOR=yolo_world
AI_DETECTOR_YOLO_WORLD_MODEL_PATH=../ai/yolo/models/custom_yolov8s_mining.pt
# Upload limits (MB) for /api/ai/detect endpoints.
MAX_IMAGE_UPLOAD_MB=10
MAX_VIDEO_UPLOAD_MB=100
# Live webcam detection (POST /api/ai/detect/frame): per-frame size cap and
# camera_events cooldown. Within the cooldown a repeated finding is evaluated
# and returned as recorded=false (reason=cooldown) - evaluated every frame,
# persisted once per window. Alerts always dedupe on the 60-min window.
MAX_FRAME_UPLOAD_MB=5
LIVE_EVENT_COOLDOWN_SECONDS=60
CAMERA_SNAPSHOT_DIR=snapshots

# --- External / government data ingestion ---
# "simulated" -> development source clearly marked as simulated data.
# Point these at a REAL provider only when you have an actual endpoint + key.
EXTERNAL_INGESTION_PROVIDER=simulated
EXTERNAL_INGESTION_API_URL=
EXTERNAL_INGESTION_API_KEY=

# --- MSG91 OTP Widget (server-side only; NEVER exposed to the frontend) ---
# MSG91_AUTHKEY: your account authkey (MSG91 panel -> Settings -> API).
#   Sent only as a request header to MSG91; never returned to clients/logs.
# MSG91_WIDGET_ID: your OTP Widget id (MSG91 panel -> OTP -> Widgets).
#   OTPs are delivered via the widget's DEFAULT SMS configuration — no
#   custom DLT template is required. Only MSG91 knows the code; this backend
#   stores just the opaque request id and verifies answers with MSG91.
MSG91_AUTHKEY=
MSG91_WIDGET_ID=
# Base URL of MSG91's OTP API (override only for testing).
MSG91_BASE_URL=https://control.msg91.com
# OTP policy (sane defaults; tweakable per deployment).
MSG91_OTP_LENGTH=6
MSG91_OTP_EXPIRY_MINUTES=10
MSG91_OTP_MAX_ATTEMPTS=5
MSG91_OTP_RESEND_COOLDOWN_SECONDS=60
# Test/dev switch: when true, endpoints skip the real SMS call (no MSG91
# spend). NEVER enable in production. Actual OTPs are still hashed+verified.
OTP_SMS_DISABLED=false
