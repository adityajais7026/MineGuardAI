[TEMPLATE]
# ============================================================================
# MineGuardAI backend - environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# --- Application ---
APP_NAME=MineGuardAI API
APP_VERSION=0.1.0
DEBUG=false
API_PREFIX=/api

# --- CORS (comma-separated list of allowed frontend origins) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
# Supabase PostgreSQL connection string (Project Settings -> Database).
# Example:
# DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres
# Leave unset for local development to use a SQLite file (backend/mineguardai.dev.db).
DATABASE_URL=

# --- Supabase project (Auth adapter + Storage) ---
# Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key: backend only. NEVER expose to the frontend or commit it.
# Required for Supabase Storage uploads (camera media bucket).
SUPABASE_SERVICE_KEY=

# --- Supabase Storage (camera media; PRIVATE bucket) ---
# Create a private bucket named below (Dashboard -> Storage -> New bucket).
# When SUPABASE_URL + SUPABASE_SERVICE_KEY are set, uploads go to Supabase
# Storage under camera/{mine_id}/{images|videos|results}/...
# Without credentials the backend stores files locally (backend/snapshots/media,
# gitignored) and reports storage_provider="local" - it never fakes Supabase.
SUPABASE_MEDIA_BUCKET=mineguard-media
# "supabase" | "local"  ("local" forces dev storage even if creds exist)
STORAGE_PROVIDER=supabase

# --- Authentication ---
# "local"  -> backend issues its own JWTs (development without Supabase Auth)
# "supabase" -> verify Supabase-issued JWTs (requires SUPABASE_URL + key)
AUTH_PROVIDER=local
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Seeded admin account (created by `python -m app.utils.seed`) ---
SEED_ADMIN_EMAIL=admin@mineguard.ai
SEED_ADMIN_PASSWORD=Admin@123

# --- AI / Computer vision ---
# "simulated" -> clearly-labelled simulated camera events (fallback mode).
# "yolo"      -> REAL YOLO inference on uploaded media via /api/ai/detect/*.
AI_DETECTOR=simulated
# Pretrained COCO model (person/car/truck/...) or your custom-trained weights
# (helmet/vest classes) for full mining-safety detection.
YOLO_MODEL_PATH=../ai/yolo/models/yolo11n.pt
# Download yolo11n.pt automatically when missing (explicit opt-in).
YOLO_AUTO_DOWNLOAD=false
# Default inference settings (overridable per request from the UI).
YOLO_CONFIDENCE=0.35
YOLO_IMGSZ=640
# Process every Nth video frame (1 = all frames, slower).
YOLO_FRAME_STRIDE=5
# Safety rule: persons per scene before a crowd alert fires.
YOLO_CROWD_THRESHOLD=4
# Upload limits (MB) for /api/ai/detect endpoints.
MAX_IMAGE_UPLOAD_MB=10
MAX_VIDEO_UPLOAD_MB=100
CAMERA_SNAPSHOT_DIR=snapshots

# --- External / government data ingestion ---
# "simulated" -> development source clearly marked as simulated data.
# Point these at a REAL provider only when you have an actual endpoint + key.
EXTERNAL_INGESTION_PROVIDER=simulated
EXTERNAL_INGESTION_API_URL=
EXTERNAL_INGESTION_API_KEY=
