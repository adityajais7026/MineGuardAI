# ============================================================================
# MineGuardAI — root environment for docker-compose (gitignored, NEVER commit)
# Copy to .env and fill in real values before `docker compose up --build`.
# ============================================================================

# Postgres password for the compose 'db' service (choose a strong password).
POSTGRES_PASSWORD=

# Backend JWT signing secret.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# --- Supabase (only if pointing the backend at Supabase instead of the
# compose 'db' service; then also set backend DATABASE_URL accordingly) ---
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_KEY=
